&ACCESS RVP
&REL 1
&PARAM EDITMASK = *
&COMMENT EHA标定系统 - 机器人主程序

; ============================================================================
; 文件说明
;   部署位置 ： KRC:\R1\Program\EHACalib\
;   同目录文件： EHACalib.dat
;               PathNum1.src ~ PathNum6.src（各路径点独立运动程序）
;   EKI 配置  ： BINKKR.xml（Port 56001，命令接收）
;   Submit   ： BINKKS.sub（Port 56000，状态上报，需配置为 Submit 自启动）
;
; 路径分发（PathJob → 调用同目录 PathNumX.src）：
;   PathNum1 : 预备点（竖直，不接触传感器）
;   PathNum2 : 标定接触点（EHA 接触力传感器，位移零点）
;   PathNum3 : 过渡点（安全收回到水平前）
;   PathNum4 : 水平姿态（力矩清零位）
;   PathNum5 : 质量补偿点（竖直，自重调零）
;   PathNum6 : 检测接触点（输出力检测）
; ============================================================================

DEF EHACalib()

   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM()
         INTERRUPT ON 3
         BAS(#INITMOV, 0)
      ;ENDFOLD (BASISTECH INI)
   ;ENDFOLD (INI)

   BAS(#INITMOV, 0)

   ; 初始化 EKI 命令通道并回到当前位置
   BINKKR_INIT()

   CONTINUE
   CYCLE:
   BINKKR_GET()

   IF CONTROL_TYPE_GET == 0 THEN      ; kConfig：触发路径程序 / 外设控制
      PathJob()
      PCJob()
   ELSE
      IF CONTROL_TYPE_GET == 1 THEN   ; kMoving：单点运动
         BINKKRMOVE()
      ENDIF
   ENDIF

   GOTO CYCLE

END

; ── BINKKR_INIT：初始化 EKI 命令通道 ─────────────────────────────────────────
DEF BINKKR_INIT()
   DECL INT I

   POS_TGT_CARTESIUS = $POS_ACT_MES
   POS_CMD_CARTESIUS = POS_TGT_CARTESIUS
   POS_TGT_AXIS = $AXIS_ACT_MEAS
   POS_CMD_AXIS = POS_TGT_AXIS
   CONTINUE
   PTP POS_TGT_AXIS

   FOR I = 1 TO 64
      Bytes[I] = 0
   ENDFOR

   ; 初始化多点路径缓存（与参考工程一致）
   FOR POSNUM = 1 TO 1000 STEP 1
      POINTS[POSNUM] = NULLPOINT
   ENDFOR

   CONNECT:
   ON_ERROR_PROCEED
   EKI_RET = EKI_INIT("BINKKR")
   ON_ERROR_PROCEED
   EKI_RET = EKI_OPEN("BINKKR")
   IF (NOT EKI_RET.CONNECTED) OR ($ERR.NUMBER > 0) THEN
      EKI_RET = EKI_CLOSE("BINKKR")
      EKI_RET = EKI_CLEAR("BINKKR")
      ERR_RAISE($ERR)
      WAIT SEC 2
      GOTO CONNECT
   ENDIF

END

; ── BINKKR_GET：阻塞等待并解析命令包 ─────────────────────────────────────────
DEF BINKKR_GET()
   WAIT SEC 0.0

   WAIT_Flag:
   TimerAction(#TimerStart, 64, -1)
   WAIT FOR ($FLAG[2] OR ($TIMER[64] >= 3000))
   ON_ERROR_PROCEED
   EKI_RET = EKI_GetString("BINKKR", "RcvBuffer", Bytes[])
   TimerAction(#TimerStop, 64, -1)

   IF NOT EKI_RET.Connected THEN
      BINKKR_INIT()
      GOTO WAIT_Flag
   ELSE
      IF NOT $FLAG[2] THEN
         GOTO WAIT_Flag
      ENDIF
   ENDIF
   $FLAG[2] = FALSE

   ; 重置所有解析变量（与参考工程完全一致）
   CONTROL_TYPE_GET    = -1
   MOVING_TYPE_GET     = -1
   COORDINATE_TYPE_GET = -1
   TOOL_NUM            = -1
   Path_NUM            = -1
   READSUCESS          = FALSE
   REVPOSLENGTH        = -1
   RECVDONE            = FALSE
   ControlValve        = -1
   SETSPEED[1]         = -1
   SETSPEED[2]         = -1
   SETSPEED[3]         = -1
   SETSPEED[4]         = -1
   POS_CMD_CARTESIUS.X = -1
   POS_CMD_CARTESIUS.Y = -1
   POS_CMD_CARTESIUS.Z = -1
   POS_CMD_AXIS        = NULLAXIS

   ; 解析命令包
   OFFSET = 0
   CAST_FROM(Bytes[], OFFSET, RCVPOS[], RCVChars[], ReadSPEED, REVPOSLENGTH)
   $VEL.CP             = ReadSPEED
   CONTROL_TYPE_GET    = RCVChars[1]   ; byte[24]
   MOVING_TYPE_GET     = RCVChars[2]   ; byte[25]
   COORDINATE_TYPE_GET = RCVChars[3]   ; byte[26]
   ;$ADVANCE            = RCVChars[4]   ; byte[27]
   $ADVANCE            = 5
   $OV_PRO             = RCVChars[5]   ; byte[28]
   TOOL_NUM            = RCVChars[6]   ; byte[29]
   Path_NUM            = RCVChars[7]   ; byte[30]
   $TOOL               = TOOL_DATA[TOOL_NUM]   ; 直接赋值，上位机保证 TOOL_NUM 有效
   $ACT_TOOL           = TOOL_NUM
   ControlValve        = RCVChars[8]   ; byte[31]

   ; 填充目标坐标（与参考工程 SWITCH/CASE 结构一致）
   SWITCH COORDINATE_TYPE_GET
      CASE 0   ; 笛卡尔坐标
         SWITCH MOVING_TYPE_GET
            CASE 0, 1, 2, 3   ; 单点运动
               POS_CMD_CARTESIUS.X = RCVPOS[1]
               POS_CMD_CARTESIUS.Y = RCVPOS[2]
               POS_CMD_CARTESIUS.Z = RCVPOS[3]
               POS_CMD_CARTESIUS.A = RCVPOS[4]
               POS_CMD_CARTESIUS.B = RCVPOS[5]
               POS_CMD_CARTESIUS.C = RCVPOS[6]
            CASE 4, 5, 6   ; 多点路径（逐包接收，本项目暂不使用）
               POSNUM = 1
               IF REVPOSLENGTH < 1 THEN
                  RECVDONE = FALSE
                  GOTO CLEAR
               ENDIF
               POS_CMD_CARTESIUS.X = RCVPOS[1]
               POS_CMD_CARTESIUS.Y = RCVPOS[2]
               POS_CMD_CARTESIUS.Z = RCVPOS[3]
               POS_CMD_CARTESIUS.A = RCVPOS[4]
               POS_CMD_CARTESIUS.B = RCVPOS[5]
               POS_CMD_CARTESIUS.C = RCVPOS[6]
               POINTS[POSNUM] = POS_CMD_CARTESIUS
               POSNUM = 2
               WHILE POSNUM <= REVPOSLENGTH
                  IF (POSNUM < 5) THEN
                     SETSPEED[POSNUM - 1] = ReadSPEED
                  ENDIF
                  EKI_RET = EKI_Send("BINKKR", Bytes[])
                  WAIT SEC 0.0
                  WAIT FOR $FLAG[2]
                  EKI_RET = EKI_GetString("BINKKR", "RcvBuffer", Bytes[])
                  $FLAG[2] = FALSE
                  OFFSET = 0
                  CAST_FROM(Bytes[], OFFSET, RCVPOS[], RCVChars[], ReadSPEED, REVPOSLENGTH)
                  POS_CMD_CARTESIUS.X = RCVPOS[1]
                  POS_CMD_CARTESIUS.Y = RCVPOS[2]
                  POS_CMD_CARTESIUS.Z = RCVPOS[3]
                  POS_CMD_CARTESIUS.A = RCVPOS[4]
                  POS_CMD_CARTESIUS.B = RCVPOS[5]
                  POS_CMD_CARTESIUS.C = RCVPOS[6]
                  POINTS[POSNUM] = POS_CMD_CARTESIUS
                  POSNUM = POSNUM + 1
               ENDWHILE
         ENDSWITCH

      CASE 1   ; 轴坐标
         POS_CMD_AXIS.A1 = RCVPOS[1]
         POS_CMD_AXIS.A2 = RCVPOS[2]
         POS_CMD_AXIS.A3 = RCVPOS[3]
         POS_CMD_AXIS.A4 = RCVPOS[4]
         POS_CMD_AXIS.A5 = RCVPOS[5]
         POS_CMD_AXIS.A6 = RCVPOS[6]

      DEFAULT
   ENDSWITCH

   RECVDONE = TRUE
   EKI_RET = EKI_Send("BINKKR", Bytes[])   ; 发送 ACK

   CLEAR:
   WAIT SEC 0

END

; ── BINKKRMOVE：执行单点/多点运动 ────────────────────────────────────────────
DEF BINKKRMOVE()
   IF NOT RECVDONE THEN RETURN ENDIF

   POS_CMD_CARTESIUS.S = $POS_ACT_MES.S
   POS_CMD_CARTESIUS.T = $POS_ACT_MES.T

   SWITCH COORDINATE_TYPE_GET
      CASE 0   ; 笛卡尔
         SWITCH MOVING_TYPE_GET
            CASE 0 : LIN POS_CMD_CARTESIUS
            CASE 1 : PTP POS_CMD_CARTESIUS
            CASE 2 : LIN_REL POS_CMD_CARTESIUS #TOOL
            CASE 3 : PTP_REL POS_CMD_CARTESIUS #TOOL
            CASE 4   ; 多点直线路径
               $APO.CDIS = 10
               $VEL.CP = SETSPEED[1]
               LIN POINTS[1] C_DIS C_Dis
               LIN POINTS[2] C_DIS C_Dis
               FOR POSNUM = 3 TO REVPOSLENGTH-1 STEP 1
                  $VEL.CP = SETSPEED[2]
                  LIN POINTS[POSNUM] C_DIS C_Dis
               ENDFOR
               $VEL.CP = SETSPEED[3]
               LIN POINTS[REVPOSLENGTH] C_DIS C_Dis
            DEFAULT
         ENDSWITCH
      CASE 1   ; 轴坐标
         PTP POS_CMD_AXIS C_PTP
      DEFAULT
   ENDSWITCH
END

; ── PathJob：路径程序分发（CASE 0 保留与参考工程一致）────────────────────────
DEF PathJob()
   SWITCH Path_NUM
      CASE 0
         ; 无操作
      CASE 1 : PathNum1()   ; 预备点
      CASE 2 : PathNum2()   ; 标定接触点
      CASE 3 : PathNum3()   ; 过渡点
      CASE 4 : PathNum4()   ; 水平姿态（力矩清零位）
      CASE 5 : PathNum5()   ; 质量补偿点
      CASE 6 : PathNum6()   ; 检测接触点
      DEFAULT
   ENDSWITCH
END

; ── PCJob：外设控制（本项目无外设，ControlValve<0 直接返回）─────────────────
DEF PCJob()
   IF ControlValve < 0 THEN
      RETURN
   ENDIF
   ; 如需扩展 IO 控制，在此添加 SWITCH ControlValve CASE ...
END

; ── EKI_RESET：紧急重置通道（供调试用）──────────────────────────────────────
DEF EKI_RESET()
   EKI_RET = EKI_CLEAR("BINKKR")
   EKI_RET = EKI_INIT("BINKKR")
   EKI_RET = EKI_OPEN("BINKKR")
END

