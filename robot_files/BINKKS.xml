<ETHERNETKRL>
    <CONFIGURATION>
        <EXTERNAL>
            <IP>192.168.1.66</IP>    <!-- 上位机 IP，与实际网卡地址一致 -->
            <PORT>56000</PORT>
        </EXTERNAL>
        <INTERNAL>
            <ENVIRONMENT>Submit</ENVIRONMENT>   <!-- 常驻后台，必须为 Submit -->
            <TIMEOUT Connect="2000"/>
            <MESSAGES Logging="disabled" Display="disabled"/>
        </INTERNAL>
    </CONFIGURATION>
    <RECEIVE>
        <RAW>
            <!-- Set_Flag="1" 收到数据后自动置 $FLAG[1]=TRUE -->
            <ELEMENT Tag="Buffer" Type="BYTE" Set_Flag="1" Size="64"/>
        </RAW>
    </RECEIVE>
    <SEND/>
</ETHERNETKRL>
